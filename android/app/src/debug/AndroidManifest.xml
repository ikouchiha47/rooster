<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only trigger surface. Merged into the debug variant's manifest only, so
  a release build has no `com.personalos.app.FORCE_SYNC` receiver at all.

  Invoke with:
    adb shell am broadcast -a com.personalos.app.FORCE_SYNC \
        -n com.personalos.app/.debug.ForceSyncReceiver

  The notify receiver takes string extras "body" and "severity", and a long
  extra "ttl" (ms). See DebugNotifyReceiver. Example:

    adb shell am broadcast -a com.personalos.app.DEBUG_NOTIFY \
        -n com.personalos.app/.debug.DebugNotifyReceiver
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.ForceSyncReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.FORCE_SYNC" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DebugNotifyReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.DEBUG_NOTIFY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.ForceBackfillReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.FORCE_BACKFILL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.ForceModelDownloadReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.DOWNLOAD_MODELS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.BackfillStatusReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.BACKFILL_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.SendSmsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.SEND_SMS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.RunEnrichReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.RUN_ENRICH" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.InjectGroupReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.INJECT_GROUP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.RunWorkflowReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.personalos.app.RUN_WORKFLOW" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
