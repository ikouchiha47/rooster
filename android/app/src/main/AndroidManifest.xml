<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Sending a reply from the Messages compose box. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Opt-in only: resolves an SMS sender to a contact's display name and backs
         the send picker's address book. When not granted, the app shows the stored
         number/header exactly as before and suggestions stay empty. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Creating a contact from the picker, visible to the whole system. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Unlisted tab: numbers from attended calls that are not saved contacts. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Active SIMs, for the per-surface send-SIM picker. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ask the user to exempt the app, so the long retag is not deferred into
         never by Doze/App Standby. Granting is optional; without it, background
         catch-up is best-effort. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The standalone foreground service that runs a long task (tagging, download)
         to completion. dataSync type + its permission, and POST_NOTIFICATIONS for
         the ongoing notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Present location for the Weather tile. Coarse is enough for a forecast and
         is what we ask for; fine is declared so the GPS provider is usable when the
         user grants it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".PersonalOSApplication"
        android:label="Rooster"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.PersonalOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runs any registered BackgroundTask in the foreground. Started from the
             foreground (a user action), which Android 12+ requires for dataSync. -->
        <service
            android:name=".data.service.ForegroundTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>