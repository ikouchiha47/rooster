      "tag": "personal",
      "group": "nature",
      "owner": "embedding",
      "description": "a personal message from an individual person",
      "terms": ""
    },
    {
      "tag": "official",
      "group": "nature",
      "owner": "lexicon",
      "description": "an official notice from a government or an organisation",
      "terms": "circular|notification|advisory|gazette|government_order|tender|public_notice|press_release"
    }
  ],
  "markers": [
    {
      "tag": "news",
      "description": "editorial content from a news source"
    }
  ],
  "derivations": [
    {
      "tag": "local",
      "from": ["place"],
      "when": "place ≈ my present or home place",
      "note": "L3 relation, not inferred. Reserved for the fact/relation engine."
    },
    {
      "tag": "travel",
      "from": ["incident", "place"],
      "when": "incident ∧ place ∧ movement-relevant(place, me)",
      "note": "L3 relation. Replaces the old lexicon term: a bank strike is incident, not travel."
    }
  ]
}
