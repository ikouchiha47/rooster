{
  "id": "bundled-v1",
  "version": 1,
  "note": "The tag vocabulary as data. A tag is defined once: its zero-shot `description` (embedding rung) and its `terms` (lexicon rung). Downloaded overrides merge over this by `tag`. `derivations` is reserved: relations computed from facts (L3), not inferred.",
  "tags": [
    {
      "tag": "weather",
      "group": "subject",
      "owner": "embedding",
      "description": "weather, rain, floods, storms, a natural disaster",
