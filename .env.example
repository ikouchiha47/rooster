# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# These keys are for host-side tooling only. The Android app itself is keyless by
# design (see docs/adrs/0001-source-layer-and-zero-cost-policy.md): Exa/Tavily are
# planned discovery sources, never ingestion sources, and are quota-metered.
TAVILY_API_KEY=
EXA_API_KEY=
RAPID_API_KEY=
