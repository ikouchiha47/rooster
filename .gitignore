# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
#
# Convention: `.env` is the *template* (keys present, values empty) and is
# tracked. The real keys live in `.env.prod` and `.env.dev`, which are ignored.
# So the per-environment files are the secrets and the plain file is the safe
# default — the same rule `sms-probe/.gitignore` applies.
# ---------------------------------------------------------------------------
.env.*
!.env

# ---------------------------------------------------------------------------
# Android / Gradle
# ---------------------------------------------------------------------------
android/.gradle/
android/.idea/
android/local.properties
android/*.iml
.cxx/
**/build/
*.apk
*.aab

# Release signing — never commit; these live as CI secrets.
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Room schemas are deliberately NOT ignored.
#
# `android/app/schemas/**` is the migration baseline: `exportSchema = true` writes
# it, and `MigrationSchemaTest` compares the migrated database against it. Losing
# it would leave migrations unverifiable.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloned dependency sources
#
# The clonedeps skill checks out library source here so it can be read locally.
# It is a cache, not part of the project.
# ---------------------------------------------------------------------------
vendor/

# ---------------------------------------------------------------------------
# macOS / scratch
# ---------------------------------------------------------------------------
.DS_Store
*.log
logs/
